@page "/"
@rendermode InteractiveServer
@inject AccountsApiClient Api

<PageTitle>Accounts — Carrington.Blake Admin</PageTitle>

<MudText Typo="Typo.h4" GutterBottom="true">Accounts</MudText>

@if (_error is not null)
{
    <MudAlert Severity="Severity.Error" Class="mb-4">
        Failed to load accounts: @_error
    </MudAlert>
}

<MudTable Items="_accounts" Hover="true" Striped="true" Loading="_loading"
          LoadingProgressColor="Color.Primary" Elevation="2">
    <ToolBarContent>
        <MudText Typo="Typo.h6">All accounts</MudText>
        <MudSpacer />
        <MudIconButton Icon="@Icons.Material.Filled.Refresh" OnClick="LoadAccountsAsync"
                       aria-label="Refresh" />
    </ToolBarContent>
    <HeaderContent>
        <MudTh>Account number</MudTh>
        <MudTh>Owner</MudTh>
        <MudTh>Type</MudTh>
        <MudTh Style="text-align:right">Balance</MudTh>
        <MudTh>Currency</MudTh>
        <MudTh>Created</MudTh>
        <MudTh>Status</MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="Account number">@context.AccountNumber</MudTd>
        <MudTd DataLabel="Owner">@context.OwnerName</MudTd>
        <MudTd DataLabel="Type">@context.Type</MudTd>
        <MudTd DataLabel="Balance" Style="text-align:right">
            <MudText Color="@(context.Balance < 0 ? Color.Error : Color.Default)">
                @context.Balance.ToString("N2")
            </MudText>
        </MudTd>
        <MudTd DataLabel="Currency">@context.Currency</MudTd>
        <MudTd DataLabel="Created">@context.CreatedAt.ToString("yyyy-MM-dd")</MudTd>
        <MudTd DataLabel="Status">
            <MudChip T="string" Size="Size.Small"
                     Color="@(context.IsActive ? Color.Success : Color.Default)">
                @(context.IsActive ? "Active" : "Inactive")
            </MudChip>
        </MudTd>
    </RowTemplate>
    <NoRecordsContent>
        <MudText>No accounts found.</MudText>
    </NoRecordsContent>
</MudTable>

@code {
    private List<AccountDto> _accounts = [];
    private bool _loading = true;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        await LoadAccountsAsync();
    }

    private async Task LoadAccountsAsync()
    {
        _loading = true;
        _error = null;
        try
        {
            _accounts = await Api.GetAccountsAsync();
        }
        catch (HttpRequestException ex)
        {
            _error = ex.Message;
            _accounts = [];
        }
        finally
        {
            _loading = false;
        }
    }
}
